{
  "name": "workhub-api",
  "version": "1.0.0",
  "private": true,
  "description": "WorkHub API - Coworking Space Management Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles --forceExit",
    "test:concurrency": "jest tests/concurrency --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "firebase-admin": "13.2.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "node-cron": "3.0.3",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "socket.io": "4.8.1",
    "swagger-ui-express": "5.0.1",
    "uuid": "11.0.5",
    "yamljs": "0.3.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0"
  }
}
